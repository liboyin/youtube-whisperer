{
    "dockerComposeFile": "../docker-compose.yaml",
    "service": "app",
    "features": {
        // base image doesn't have sudo
        "ghcr.io/devcontainers/features/common-utils:2": {
            "configureZshAsDefaultShell": true
        }
    },
    "overrideCommand": true,
    "postCreateCommand": "chmod +x .devcontainer/postCreateCommand.sh && ./.devcontainer/postCreateCommand.sh",
    "remoteUser": "ubuntu",
    "workspaceFolder": "/workspaces/youtube-whisperer",
    "mounts": [
        // share Git + SSH + Claude Code plugins config between host and container
        "source=${localEnv:HOME}/.gitconfig,target=/home/ubuntu/.gitconfig,type=bind,readonly",
        "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,readonly",
        "source=${localEnv:HOME}/.claude/plugins/installed_plugins.json,target=/home/ubuntu/.claude/plugins/installed_plugins.json,type=bind",
        // override .dockerignore to mount the entire workspace
        "source=${localWorkspaceFolder},target=/workspaces/youtube-whisperer,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "charliermarsh.ruff",
                "mhutchie.git-graph",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-vscode.live-server",
                "openai.chatgpt",
                "ryu1kn.partial-diff",
                "streetsidesoftware.code-spell-checker",
                "tamasfe.even-better-toml",
                "yzhang.markdown-all-in-one"
            ]
        }
    }
}
