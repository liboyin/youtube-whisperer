{
    "dockerComposeFile": "../docker-compose.yaml",
    "service": "app",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2":{
            "configureZshAsDefaultShell": "true"
        }
    },
    "overrideCommand": true,
    "remoteUser": "ubuntu",
    "workspaceFolder": "/workspaces/youtube-whisperer",
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=tmpfs",
        "source=${localWorkspaceFolder},target=/workspaces/youtube-whisperer,type=bind"
    ],
    "postCreateCommand": "chmod +x .devcontainer/postCreateCommand.sh && ./.devcontainer/postCreateCommand.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "charliermarsh.ruff",
                "mhutchie.git-graph",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-vscode.live-server",
                "openai.chatgpt",
                "ryu1kn.partial-diff",
                "streetsidesoftware.code-spell-checker",
                "tamasfe.even-better-toml",
                "yzhang.markdown-all-in-one"
            ]
        }
    }
}
